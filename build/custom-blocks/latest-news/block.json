{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mojblocks/latest-news",
	"title": "Latest News",
	"description": "Display latest news items",
	"category": "mojblocks",
	"icon": "slides",
	"textdomain": "mojblocks",
	"keywords": ["latest news", "recent news", "headlines"],
	"editorScript": "mojblocks-editor-script",
	"attributes": {
		"latestNewsHasDate": {
			"type": "boolean",
			"default": true
		},
		"latestNewsExpiry": {
			"type": "integer",
			"default": 0
		},
		"latestNewsEmptyText": {
			"type": "string",
			"default": "No news to display."
		},
		"latestNewsNumber": {
			"type": "integer"
		}
	}
}
